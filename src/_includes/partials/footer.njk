<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      {# About Column #}
      <div class="footer-about">
        <p class="footer-col__title">{{ site.name }}</p>
        <p>{{ site.tagline }}</p>
        <p class="mt-md">
          <a href="https://www.google.com/maps/search/?api=1&query=18+St+Albans+Rd+Medlow+Bath+NSW+2780" class="footer-address-link" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {{ site.address }}
          </a>
        </p>
        <div class="footer-social mt-lg">
          <a href="https://www.instagram.com/" class="footer-social__link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="https://www.facebook.com/" class="footer-social__link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://x.com/" class="footer-social__link" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/" class="footer-social__link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>

      {# Services Column #}
      <div>
        <p class="footer-col__title">Services</p>
        <ul class="footer-col__list">
          {% for service in site.services %}
            <li><a href="{{ service.url }}">{{ service.name }}</a></li>
          {% endfor %}
        </ul>
      </div>

      {# Quick Links Column #}
      <div>
        <p class="footer-col__title">Quick Links</p>
        <ul class="footer-col__list">
          {% for item in site.navigation %}
            <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      {# Hours Column #}
      <div>
        <p class="footer-col__title">Hours</p>
        <table class="footer-hours">
          <tbody>
            <tr><td>Monday</td><td>8:30 am – 5 pm</td></tr>
            <tr><td>Tuesday</td><td>8:30 am – 5 pm</td></tr>
            <tr><td>Wednesday</td><td>8:30 am – 5 pm</td></tr>
            <tr><td>Thursday</td><td>8:30 am – 5 pm</td></tr>
            <tr><td>Friday</td><td>8:30 am – 5 pm</td></tr>
            <tr class="footer-hours--closed"><td>Saturday</td><td>Closed</td></tr>
            <tr class="footer-hours--closed"><td>Sunday</td><td>Closed</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="footer-contact-btns">
      <a href="tel:{{ site.phoneRaw }}" class="btn btn--footer-contact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {{ site.phone }}
      </a>
      <a href="mailto:{{ site.email }}" class="btn btn--footer-contact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {{ site.email }}
      </a>
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ "" | currentYear }} {{ site.name }}. All rights reserved.</p>
      <p><a href="/privacy/">Privacy Policy</a></p>
    </div>
  </div>
</footer>
