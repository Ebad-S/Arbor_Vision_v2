<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="{{ site.name }} - Home">
      <!-- TODO: Replace with actual logo image -->
      <img src="/favicon.svg" alt="" width="28" height="28" aria-hidden="true">
      <span>{{ site.name }}</span>
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation" data-open="false">
      <ul class="site-nav__list">
        {% for item in site.navigation %}
          <li>
            <a
              href="{{ item.url }}"
              class="site-nav__link"
              {% if page.url == item.url %}aria-current="page"{% endif %}
            >
              {{ item.label }}
            </a>
          </li>
        {% endfor %}
        <li>
          <a href="/contact/" class="site-nav__cta">
            Get in Touch
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
