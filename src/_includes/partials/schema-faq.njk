{# JSON-LD FAQPage schema - for pages with FAQ sections #}
{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": "{{ faq.q }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ faq.a }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
